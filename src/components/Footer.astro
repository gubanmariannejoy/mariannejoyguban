---
// Footer.astro
const exploreLinks = [
  { name: 'Home', href: '#home' },
  { name: 'Projects', href: '#projects' },
  { name: 'About us', href: '#about' },
  { name: 'Services', href: '#services' },
];
---

<footer class="w-full bg-[#0a0a0a] text-white pt-12 pb-8 px-8">
  <div class="max-w-7xl mx-auto">
    <!-- Top Grid Section -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 pb-12">
      <!-- Column 1: Brand Info -->
      <div class="space-y-2">
        <h3 class="font-bold text-white text-lg tracking-wider">
          MIRAE STUDY CAFE
        </h3>
        <p class="text-stone-300 text-sm">
          Good Coffee , Good Mood
        </p>
      </div>

      <!-- Column 2: Explore Links -->
      <div>
        <div class="flex items-center space-x-2 mb-4">
          <span class="w-1 h-4 bg-[#8c5a32] block"></span>
          <h4 class="font-bold text-xs uppercase tracking-wider text-white">
            EXPLORE
          </h4>
        </div>
        <ul class="space-y-3 text-sm">
          {exploreLinks.map((link) => (
            <li>
              <a 
                href={link.href} 
                class="text-stone-300 hover:text-[#8c5a32] transition-colors"
              >
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 3: Contact Info -->
      <div>
        <div class="flex items-center space-x-2 mb-4">
          <span class="w-1 h-4 bg-[#8c5a32] block"></span>
          <h4 class="font-bold text-xs uppercase tracking-wider text-white">
            COME SAY HELLO
          </h4>
        </div>
        <p class="text-stone-300 text-sm leading-relaxed max-w-sm">
          Have a question or an idea to share? We would love to hear from you.
        </p>
      </div>
    </div>

    <!-- Bottom Divider & Copyright -->
    <div class="border-t border-stone-800 pt-6">
      <p class="text-xs text-stone-400">
        &copy; 2026 Mirae Study Cafe. All rights reserved.
      </p>
    </div>
  </div>
</footer>