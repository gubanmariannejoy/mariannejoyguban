<!-- CONTACT SECTION -->
        <section id="contact" class="section bg-white dark:bg-secondary reveal min-h-[60vh]">

            <h2 class="section-title">
                Let's Connect
            </h2>

            <p class="section-description">
                Have a question or suggestion?
                Send us a message. We would love to hear from you!
            </p>

            <div class="contact-container">

                <!-- CONTACT INFORMATION -->
                <div class="contact-info">

                    <h3 class="contact-title">
                        Get in Touch
                    </h3>

                    <p class="contact-text">
                        We welcome your questions, feedback,
                        and suggestions. Contact us to learn
                        more about Mirae Study Cafe.
                    </p>

                    <p class="contact-text">
                        <strong>Business:</strong><br>
                        Mirae Study Cafe
                    </p>

                    <p class="contact-text">
                        <strong>Our Goal:</strong><br>
                        Your space to learn and grow.
                    </p>

                </div>

                <!-- CONTACT FORM -->
                <form action="#" class="contact-form">

                    <div>
                        <label for="name" class="form-label">
                            Full Name
                        </label>

                        <input type="text" id="name" name="name" placeholder="Enter your full name" class="form-input"
                            required>
                    </div>

                    <div>
                        <label for="email" class="form-label">
                            Email Address
                        </label>

                        <input type="email" id="email" name="email" placeholder="Enter your email" class="form-input"
                            required>
                    </div>

                    <div>
                        <label for="message" class="form-label">
                            Your Message
                        </label>

                        <textarea id="message" name="message" rows="5" placeholder="Write your message here..."
                            class="form-input" required></textarea>
                    </div>

                    <button type="submit" class="btn-primary">
                        Send Message
                    </button>

                </form>

            </div>

        </section>

         <!-- DARK MODE BUTTON -->
    <div class="flex justify-center gap-4 bg-white py-6 dark:bg-secondary">

        <button id="theme-toggle" type="button" class="btn-primary">
            ToggleButton
        </button>
    </div>
